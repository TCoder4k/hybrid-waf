# ML service HTTP port
ML_SERVICE_PORT=8001

# uvicorn worker process count (Phase P3a, docs/architecture.md §22). The
# /predict endpoint does CPU-bound scikit-learn inference — a single worker
# GIL-serializes every concurrent request, which was the confirmed
# throughput bottleneck under load testing. Set to the deployment host's
# actual CPU core count (check with `nproc`); 2 is a conservative default
# for a small VPS, not a tuned value for any specific host.
WORKERS=2
