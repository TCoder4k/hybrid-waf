# HTTP
PORT=3000

# PostgreSQL — connection wired starting Phase 2 (Database + Core Domain)
DATABASE_URL=postgresql://waf_user:changeme@localhost:5432/hybrid_waf

# Admin JWT — wired starting Phase 9 (Admin Authentication), per docs/architecture.md §13
JWT_SECRET=changeme
JWT_EXPIRES_IN=30m

# Used only by `npm run seed:admin` to create/update the one Admin row —
# never read by the running app itself.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Downstream services
ML_SERVICE_URL=http://localhost:8001

# Canonical upstream target the WAF forwards ALLOWed traffic to — any
# reachable web/API, not just the bundled protected-api demo service
# (docs/architecture.md §21, ADR-8). If unset, PROTECTED_API_URL is read as
# a temporary backward-compatible alias, then this same localhost:3001
# default.
UPSTREAM_URL=http://localhost:3001
# PROTECTED_API_URL=http://localhost:3001

# Proxy hardening (Phase P2, docs/architecture.md §22) — all optional, sane
# defaults shown here.
# How long to wait for the upstream before returning 504.
UPSTREAM_TIMEOUT_MS=10000
# Request body size cap (bytes) enforced on every route, including
# /admin/*.
MAX_BODY_SIZE_BYTES=1048576
# Slowloris protection: max time to finish sending headers / the whole
# request before Node closes the connection.
REQUEST_HEADERS_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000

# Hybrid Decision Engine — wired starting Phase 7, per docs/architecture.md §8.
# Minimum ML confidence (0-1) required to BLOCK on an ML-only verdict (rule
# engine found nothing). Below this, the request is ALLOWed.
ML_CONFIDENCE_THRESHOLD=0.7

# ML onboarding mode (Phase P5, docs/architecture.md §23) — one of
# HYBRID_BLOCK (default, full enforcement), RULE_BLOCK_ML_MONITOR (rule
# blocks as normal, ML is evaluated/logged but never blocks), or MONITOR
# (nothing is ever blocked — for observing a newly-protected site's traffic
# before enabling enforcement). An unrecognized value falls back to
# HYBRID_BLOCK.
WAF_MODE=HYBRID_BLOCK

# Dashboard (frontend) origin — wired starting Phase 10. When set, CORS is
# enabled for exactly this one origin (never a wildcard) so the browser-based
# Dashboard can call the Admin API directly. Unset = no cross-origin access.
FRONTEND_URL=http://localhost:3002
